<Application x:Class="DisplayShot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="ChromeBrush" Color="#F01A1A1A" />
        <SolidColorBrush x:Key="ChromeBorderBrush" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#2EFFFFFF" />
    </Application.Resources>
</Application>
